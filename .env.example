# Use letters and numbers only. The two passwords must be different.
CUSTOMER_PASSWORD=change-me
SHOP_PASSWORD=change-me-too

# At least 32 characters. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Where the database and uploaded files live. Default is ./data
# Required on Hostinger Web Apps, so that orders survive a redeploy.
# DATA_DIR=~/print-orders-data

# SMS to the print shop when a new design is uploaded (text.lk). Leave the token
# empty to turn SMS off. At most one SMS is sent every SMS_GAP_HOURS hours.
TEXTLK_API_TOKEN=
SMS_TO=0783100177
SMS_SENDER_ID=amigotap
SMS_GAP_HOURS=5
